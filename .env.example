# Copy to .env and fill in. .env is gitignored — never commit real values.
#
#   cp .env.example .env
#
# Config is read by internal/config.Load(), which also auto-loads this file's
# real counterpart from the working directory. Environment variables always win
# over the file, so a container can override any single key.

# --- Server ----------------------------------------------------------------
PORT=8080
JWT_ISSUER=ta-payment
JWT_LIFETIME=12h
UPLOAD_DIR=./data/uploads
# NOTE: MAX_UPLOAD_MB is currently NOT read by anything. The per-file limit for
# TA documents is maxDocBytes in internal/service/docs.go (10 MB).
MAX_UPLOAD_MB=20

# --- Virus scanning (uploaded documents) -------------------------------------
# clamd address. Empty = scanning disabled, and the backend logs a warning at
# startup saying uploads are unscanned.
#
# When set, uploads FAIL CLOSED: if clamd cannot be reached or cannot finish a
# scan, the upload is refused (503) rather than stored unscanned. Enabling this
# makes clamd required infrastructure — see the clamav service in
# docker-compose.yml, and expect the first boot to take a few minutes while the
# signature database downloads.
CLAMAV_ADDR=
CLAMAV_TIMEOUT=30s

# --- Database --------------------------------------------------------------
# Either set DATABASE_URL directly, or these five (docker-compose style).
DB_HOST=localhost
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=ta_payment

# --- Auth ------------------------------------------------------------------
# Required. Generate a long random value, e.g.
#   openssl rand -base64 48
# Rotating this invalidates every active session.
JWT_SECRET=

# --- URLs ------------------------------------------------------------------
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:3000
APP_BASE_URL=http://localhost:3000

# --- Initial admin (used only on first boot, by cmd/seed) -------------------
SEED_ADMIN_EMAIL=admin@example.ac.th
SEED_ADMIN_PASSWORD=

# --- Email -----------------------------------------------------------------
# Leave SMTP_HOST empty to disable outbound mail (notifications stay in-app).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@example.ac.th

# --- SSO (optional) --------------------------------------------------------
# SSO is enabled only when both SSO_AUTH_URL and SSO_CLIENT_ID are set.
SSO_AUTH_URL=
SSO_TOKEN_URL=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_REDIRECT=

# --- Document encryption at rest -------------------------------------------
# 32-byte AES-256 key, base64. Generate with:
#   openssl rand -base64 32
# WARNING: uploaded TA documents are encrypted with this key. Changing it makes
# every previously stored document unreadable. Leaving it empty stores files in
# plaintext — the server logs a warning at boot.
TA_DOCS_ENC_KEY=

# 32-byte XChaCha20-Poly1305 key, base64. Generate with:
#   openssl rand -hex 32
# REQUIRED — the server refuses to start without it. Encrypts only the TA
# citizen ID (ta_profiles.citizen_id_enc); deliberately a separate secret from
# TA_DOCS_ENC_KEY so one leaking does not leak the other. Changing it makes
# every previously stored citizen ID unrecoverable (see citizen_id_key_version
# if a rotation path is ever needed).
PII_ENC_KEY=

# --- Bank of Thailand holiday API (optional) -------------------------------
# Without a client id the "sync from BOT" button returns 503.
BOT_API_BASE_URL=https://gateway.api.bot.or.th/financial-institutions-holidays
BOT_API_CLIENT_ID=

CLAMAV_ADDR=127.0.0.1:3310