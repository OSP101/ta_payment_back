# Copy to .env and fill in. .env is gitignored — never commit real values.
#
#   cp .env.example .env
#
# Config is read by internal/config.Load(), which also auto-loads this file's
# real counterpart from the working directory. Environment variables always win
# over the file, so a container can override any single key.

# --- Server ----------------------------------------------------------------
PORT=8080
JWT_ISSUER=ta-payment
JWT_LIFETIME=12h
UPLOAD_DIR=./data/uploads
# NOTE: MAX_UPLOAD_MB is currently NOT read by anything. The per-file limit for
# TA documents is maxDocBytes in internal/service/docs.go (10 MB).
MAX_UPLOAD_MB=20

# --- Virus scanning (uploaded documents) -------------------------------------
# clamd address. Empty = scanning disabled, and the backend logs a warning at
# startup saying uploads are unscanned.
#
# When set, uploads FAIL CLOSED: if clamd cannot be reached or cannot finish a
# scan, the upload is refused (503) rather than stored unscanned. Enabling this
# makes clamd required infrastructure — see the clamav service in
# docker-compose.yml, and expect the first boot to take a few minutes while the
# signature database downloads.
CLAMAV_ADDR=
CLAMAV_TIMEOUT=30s

# --- Database --------------------------------------------------------------
# Either set DATABASE_URL directly, or these five (docker-compose style).
DB_HOST=localhost
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=ta_payment

# --- Auth ------------------------------------------------------------------
# Required. Generate a long random value, e.g.
#   openssl rand -base64 48
# Rotating this invalidates every active session.
JWT_SECRET=

# --- URLs ------------------------------------------------------------------
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:3000
# The system's public address. E-mail links and buttons are built from it, so
# in production it must be the real domain, never localhost.
APP_BASE_URL=http://localhost:3000

# --- Initial admin (used only on first boot, by cmd/seed) -------------------
# SEED_ADMIN_PASSWORD has no default and must not be left blank: cmd/seed exits
# with an error rather than creating an admin account with a guessable password.
SEED_ADMIN_EMAIL=admin@example.ac.th
SEED_ADMIN_PASSWORD=

# --- Email -----------------------------------------------------------------
# Leave SMTP_HOST empty to disable outbound mail (notifications stay in-app).
# Production uses the university relay: SMTP_HOST=smtp.kku.ac.th with the
# values below (issued by สำนักเทคโนโลยีดิจิทัล). Left empty here so a dev copy
# of this file never mails real people. Check a deployment under
# ตั้งค่า > ทดสอบอีเมล (the connection check sends nothing).
SMTP_HOST=
SMTP_PORT=587
# tls = STARTTLS on 587, ssl = encrypted from the start on 465, none = plain.
# (SMTP_SECURE=true, the other KKU systems' spelling, is also understood.)
# The relay's certificate is always verified; there is no switch to skip it.
SMTP_ENCRYPTION=tls
# The KKU relay admits the server by IP: leave both empty. If one is set, the
# other must be too.
SMTP_USER=
SMTP_PASS=
# Must be an @kku.ac.th address or the relay refuses it. (EMAIL_FROM, which
# may be written "Name <addr>", and the old MAIL_FROM still work.)
MAILER_FROM=no-reply-coco-tas@kku.ac.th
MAILER_FROM_NAME=COCO TAS
# smtp.kku.ac.th only offers RSA key-exchange ciphers. The mailer retries with
# them automatically; true skips the failed first attempt.
SMTP_TLS_LEGACY_CIPHERS=true

# --- KKU Single Sign On (SSONext, optional) ---------------------------------
# App ID / Client ID / Client Secret come from สำนักเทคโนโลยีดิจิทัล after
# registering the app; SSO is enabled only when all three are set.
# KKU_SSO_ENV picks the host pair those credentials belong to: prod (default)
# or uat. A new app is issued UAT credentials first; they work only with uat,
# and production credentials only with prod.
KKU_SSO_ENV=prod
KKU_SSO_APP_ID=
KKU_SSO_CLIENT_ID=
KKU_SSO_CLIENT_SECRET=
# The two URLs filed with สำนักฯ on the request form. The login callback is
# echoed back on the token exchange, so it must match what was registered
# character for character. Leave either empty to use APP_BASE_URL +
# /login/sso and + /login respectively.
KKU_SSO_REDIRECT_URL=
KKU_SSO_LOGOUT_REDIRECT_URL=
# Whether "ออกจากระบบ" here also ends the KKU session. SSONext's logout is
# GLOBAL: true signs the person out of e-learning, REG and mail as well.
# Leave false unless this runs on shared lab machines, where the next person
# inheriting a live KKU session is the bigger risk.
KKU_SSO_SINGLE_LOGOUT=false
# Override either host outright (beats KKU_SSO_ENV). Dev only: point both at
# `go run ./cmd/ssonext-mock` (default :8099) to exercise the whole flow
# without real credentials.
#KKU_SSO_WEB_BASE_URL=http://localhost:8099
#KKU_SSO_API_BASE_URL=http://localhost:8099

# --- Document encryption at rest -------------------------------------------
# 32-byte AES-256 key, base64. Generate with:
#   openssl rand -base64 32
# WARNING: uploaded TA documents are encrypted with this key. Changing it makes
# every previously stored document unreadable. Leaving it empty stores files in
# plaintext — the server logs a warning at boot.
TA_DOCS_ENC_KEY=

# 32-byte XChaCha20-Poly1305 key, base64. Generate with:
#   openssl rand -hex 32
# REQUIRED — the server refuses to start without it. Encrypts only the TA
# citizen ID (ta_profiles.citizen_id_enc); deliberately a separate secret from
# TA_DOCS_ENC_KEY so one leaking does not leak the other. Changing it makes
# every previously stored citizen ID unrecoverable (see citizen_id_key_version
# if a rotation path is ever needed).
PII_ENC_KEY=

# 32-byte XChaCha20-Poly1305 key, base64. Generate with:
#   openssl rand -hex 32
# REQUIRED — the server refuses to start without it. Encrypts TOTP secrets
# for two-factor authentication (users.totp_secret_enc); a THIRD separate
# secret from both TA_DOCS_ENC_KEY and PII_ENC_KEY. Changing it makes every
# enrolled user's stored TOTP secret unrecoverable — see docs/SECURITY.md's
# "Two-factor authentication (2FA)" section before rotating this on a live
# system with any 2FA-enrolled accounts.
TOTP_ENC_KEY=

# Default true — admin/staff/executive accounts are BLOCKED from every
# endpoint except /me, /me/2fa/*, and /auth/heartbeat until they enrol 2FA.
# Set to false as a temporary operational escape hatch (e.g. rolling this
# feature out before anyone has a real authenticator enrolled yet, or an
# incident where enforcement itself is the thing blocking someone in). Does
# NOT disable 2FA for accounts that already enrolled — those are still
# challenged at login either way. See config.Config.MFAMandatoryEnforced.
MFA_MANDATORY_ENFORCED=true

# --- TDBM (college teaching-compensation system) ---------------------------
# Holidays + lecturer-filed makeup ("สอนชดเชย") submissions — see
# docs/TDBM-API-requirements.md. POST /api/v1/tdbm-webhook is unauthenticated
# by design (decided 2026-09-15) — see TDBMHandler.Webhook's doc comment; the
# hourly scheduler sweep is the fallback if a ping is ever missed or spoofed.
TDBM_API_BASE_URL=https://tdbm.computing.kku.ac.th/api

CLAMAV_ADDR=127.0.0.1:3310